# Copy this file to `.env` and adjust as needed.
# The server reads these at startup; sensible defaults are applied if absent.

# HTTP port the server listens on.
PORT=3000

# Path to the SQLite database file. Created automatically on first run.
# Use ":memory:" for an ephemeral in-memory DB (useful for tests/demos).
DB_PATH=./data/tasks.db

# Enable verbose request logging. true | false
LOG_REQUESTS=true
